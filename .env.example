# MongoDB Atlas connection string. The database name goes after .net/ — here: portfolio
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority&appName=App

# Signing key for session JWTs. Regenerate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-auth-secret

# The single account allowed into /dashboard, via Google OR email+password.
# Required: when unset every sign-in is refused. Must match the email of
# the Google account you actually sign in with, exactly.
AUTHORIZED_GOOGLE_EMAIL=your-email@gmail.com

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI must be exactly: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret

# SMTP settings for sending contact form emails via nodemailer
# For Gmail: use your Google account app password (App passwords, not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECIPIENT=your-email@gmail.com
